---
import { RiHeartPulseLine, RiCalendarLine } from "@remixicon/react"

const links = [
  { href: "/book", label: "Book appointment" },
  { href: "/lookup", label: "Find booking" },
  { href: "/appointments", label: "My appointments" },
]
---

<header class="sticky top-0 z-40 border-b bg-background/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 lg:px-8">
    <a href="/" class="flex items-center gap-2.5">
      <span class="grid size-9 place-items-center rounded-xl bg-primary text-primary-foreground">
        <RiHeartPulseLine size={22} />
      </span>
      <span class="text-xl font-bold tracking-tight">CareSlot</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-muted-foreground transition hover:text-primary"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="/book"
      class="inline-flex h-10 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-semibold text-primary-foreground hover:opacity-90"
    >
      <RiCalendarLine size={17} />
      Book a visit
    </a>
  </div>

  <nav class="flex gap-5 overflow-x-auto border-t px-5 py-3 md:hidden">
    {links.map((link) => (
      <a
        href={link.href}
        class="whitespace-nowrap text-xs font-medium text-muted-foreground"
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
