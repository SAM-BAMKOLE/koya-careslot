---
import MainLayout from "@/layouts/main.astro"
import { RiErrorWarningLine } from "@remixicon/react"
---

<MainLayout title="Page Not Found | CareSlot">
  <section class="mx-auto flex max-w-xl flex-col items-center px-5 py-28 text-center">
    <RiErrorWarningLine className="size-16 text-primary" />

    <h1 class="mt-6 text-4xl font-bold">Page not found</h1>

    <p class="mt-3 text-muted-foreground">
      The page you are looking for doesn't exist or may have moved.
    </p>

    <a
      href="/"
      class="mt-7 rounded-lg bg-primary px-6 py-3 font-semibold text-primary-foreground"
    >
      Return home
    </a>
  </section>
</MainLayout>
