{
  "name": "careslot",
  "private": true,
  "version": "1.0.0",
  "description": "CareSlot clinic appointment booking application",
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "test": "pnpm --filter api test",
    "lint": "pnpm --filter api lint && pnpm --filter web lint",
    "typecheck": "pnpm --filter api typecheck && pnpm --filter web typecheck",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:generate": "pnpm --filter api db:generate"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  }
}
